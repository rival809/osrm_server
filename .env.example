# ========================================
# OSRM Service Configuration
# ========================================
# For production deployment as internal microservice
# Backend Sambara Gateway Pattern

# Application
NODE_ENV=production
PORT=8080

# OSRM Backend
OSRM_URL=http://osrm-backend:5000

# ========================================
# Tile Server Configuration (Self-Hosted)
# ========================================

# OFFLINE_MODE: Set to 'true' for 100% offline (no external tile downloads)
# - true  = Only use cached tiles, error if tile not found
# - false = Download from tile server if not cached (default)
OFFLINE_MODE=true

# TILE_SERVER_URL: URL to your local tile server (optional)
# Leave empty to use OSM servers (requires OFFLINE_MODE=false)
# Examples:
# - http://localhost:8000 (tileserver-gl on localhost)
# - http://tileserver:8080 (Docker container)
# - http://192.168.1.100:8000 (local network server)
# TILE_SERVER_URL=

# Cache Configuration
CACHE_DIR=./cache
CACHE_MODE=smart                 # smart, preload, proxy (use 'smart')
PRELOAD_ENABLED=false           # Keep false - use CACHE-MANAGER.sh for preload
TILE_CACHE_TTL=180000     # 3 minutes (milliseconds)
MAX_CACHE_SIZE_MB=2000          # 2GB cache limit (adjust based on disk space)

# Memory Configuration
MAX_MEMORY_MB=12000              # Maximum memory in MB

# Logging
LOG_LEVEL=info                   # error, warn, info, http, debug

# Rate Limiting (Nginx handles primary rate limiting)
RATE_LIMIT_WINDOW_MS=60000      # 1 minute
RATE_LIMIT_MAX_REQUESTS=100     # Max requests per window

# Backend Sambara Integration (Optional - for reference)
# BACKEND_SAMBARA_URL=http://backend-sambara-ip
# ALLOWED_ORIGINS=http://backend-sambara-ip
