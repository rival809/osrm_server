# ========================================
# OSRM Service Configuration
# ========================================
# Lightweight Proxy Architecture (Self-Hosted)
# For production deployment as internal microservice

# Application Environment
NODE_ENV=production
PORT=81

# OSRM Backend URL
# Local/Development: http://localhost:5000
# Docker Compose: http://osrm-backend:5000
OSRM_URL=http://osrm-backend:5000

# Tileserver URL (REQUIRED for self-hosted)
# Local/Development: http://localhost:5001/styles/basic-preview
# Docker Compose: http://tileserver:8080/styles/basic-preview
TILE_SERVER_URL=http://tileserver:8080/styles/basic-preview

# Memory Management
MAX_MEMORY_MB=10000

# Logging
LOG_LEVEL=info

# ========================================
# Notes:
# ========================================
# - Rate limiting DISABLED (handled at Backend Sambara Gateway)
# - No cache configuration needed (lightweight proxy)
# - OSRM_URL and TILE_SERVER_URL use Docker service names in production
# - For local testing, use localhost URLs instead
